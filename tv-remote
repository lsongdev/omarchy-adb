#!/usr/bin/env bash
# ADB shim for the Omarchy Android TV remote bar widget.
#
#   tv-remote key <KEYCODE>        send a key event
#   tv-remote text <string> [enter] type a string, optionally submit
#   tv-remote clear [n]            send n backspaces (default 24) to wipe a field
#   tv-remote app <package>        launch an app by package name
#   tv-remote inputs               open the input / source picker
#   tv-remote apps                 list launchable package names, one per line
#   tv-remote status               "up" / "down" / "unauth" / "noadb"
#   tv-remote reauth               re-trigger the device's USB-debugging prompt
#
# The TV address comes from $TV_ADB_ADDR (the widget passes its configured
# value). Falls back to the first already-connected device so the script is
# usable by hand.
#
# adb-over-wifi drops when the TV sleeps, so every action reconnects on demand.
set -uo pipefail

TV="${TV_ADB_ADDR:-}"

if ! command -v adb >/dev/null 2>&1; then
  # Reported rather than fatal so the widget can show a distinct state.
  [ "${1-}" = "status" ] && { echo noadb; exit 0; }
  echo "adb not found — install it (Arch: pacman -S android-tools)" >&2
  exit 127
fi

if [ -z "$TV" ]; then
  TV=$(adb devices 2>/dev/null | awk '/\tdevice$/ {print $1; exit}')
  [ -n "$TV" ] || { [ "${1-}" = "status" ] && { echo down; exit 0; }; echo "no TV address set (TV_ADB_ADDR)" >&2; exit 1; }
fi

# What `adb devices` says about this TV ("device", "unauthorized", "offline"),
# or nothing when it is not listed. awk with a string compare rather than grep
# with an interpolated pattern: an address is full of dots, and in a regex each
# one matches any character.
devstate() {
  adb devices 2>/dev/null | awk -v t="$TV" '$1 == t { print $2; exit }'
}

connected() { [ "$(devstate)" = "device" ]; }

# A device that answered but whose debugging prompt was dismissed (or was never
# accepted) sits in "unauthorized" indefinitely. That needs a human to tap Allow,
# not another reconnect, so it gets its own state instead of being flattened
# into "down" where the widget cannot tell the two apart.
unauthorized() { [ "$(devstate)" = "unauthorized" ]; }

# The word the widget reads. Takes the check that means "up", because status
# may reconnect first and reauth must not: it reports what the bounce left.
report() {
  if "$@"; then echo up
  elif unauthorized; then echo unauth
  else echo down
  fi
}

ensure() {
  connected && return 0
  adb connect "$TV" >/dev/null 2>&1
  for _ in 1 2 3; do connected && return 0; sleep 0.4; done
  return 1
}

need() { ensure || { echo "tv unreachable" >&2; exit 1; }; }
sh_() { adb -s "$TV" shell "$1" >/dev/null 2>&1; }

case "${1:-}" in
  key)
    need; sh_ "input keyevent ${2:?keycode required}" ;;

  text)
    # Single-quoted for the device shell (embedded quotes escaped), which keeps
    # shell metacharacters inert.
    #
    # Caveat: Android's `input text` treats %s as a space with no escape for a
    # literal %, so "100%sure" types as "100 ure".
    need
    payload=${2-}
    [ -n "$payload" ] || exit 0
    quoted=$(printf "'%s'" "$(printf '%s' "$payload" | sed "s/'/'\\\\''/g")")
    sh_ "input text $quoted"
    # A trailing "enter" submits in THIS process. Firing the text and the ENTER
    # as two detached calls races them: the ENTER lands mid-string and submits
    # after the first character.
    if [ "${3-}" = "enter" ]; then
      sleep 0.3
      sh_ "input keyevent KEYCODE_ENTER"
    fi
    ;;

  clear)
    need
    n=${2:-24}
    case "$n" in (''|*[!0-9]*) n=24 ;; esac
    [ "$n" -gt 200 ] && n=200
    # Backspace only eats what is behind the cursor, and a field opened for
    # editing can leave it anywhere, so jump to the end first. One adb
    # round-trip rather than n of them.
    seq=" KEYCODE_MOVE_END"; i=0
    while [ "$i" -lt "$n" ]; do seq="$seq KEYCODE_DEL"; i=$((i+1)); done
    sh_ "input keyevent$seq"
    ;;

  app)
    need; sh_ "monkey -p ${2:?package required} -c android.intent.category.LEANBACK_LAUNCHER 1" ;;

  inputs)
    # KEYCODE_TV_INPUT first (works on some brands), then the standard Android
    # TV input picker. On Hisense the keycode is a no-op and the vendor source
    # panel is only reachable via protected broadcasts, so SETUP_INPUTS is what
    # actually opens a picker there.
    need
    sh_ "input keyevent KEYCODE_TV_INPUT"
    sleep 0.4
    sh_ "am start -a android.media.tv.action.SETUP_INPUTS"
    ;;

  apps)
    # Launchable packages, for choosing the shortcut buttons. LEANBACK_LAUNCHER
    # rather than the phone LAUNCHER category: on a TV the latter also lists
    # things with no ten-foot UI that cannot actually be opened from the couch.
    #
    # The device has no display names to offer -- PackageManager exposes labels
    # to apps, not to `cmd package` -- so this returns package names only and the
    # widget derives something readable from them.
    need
    adb -s "$TV" shell "cmd package query-activities --brief \
      -a android.intent.action.MAIN -c android.intent.category.LEANBACK_LAUNCHER" 2>/dev/null \
      | tr -d '\r' \
      | grep -oE "^[[:space:]]+[A-Za-z0-9_.]+/" \
      | tr -d ' /' \
      | sort -u
    ;;

  status)
    report ensure ;;

  reauth)
    # Re-show the "Allow USB debugging?" dialog on the device.
    #
    # Only a full server restart does this. `adb disconnect` + `connect` is not
    # enough -- adbd remembers that this host's key was refused and fails the
    # handshake again with nothing on screen. Bouncing the local server forces a
    # fresh key exchange, which is what puts the dialog back up.
    #
    # Cost: kill-server drops EVERY connected device, not just this one. That is
    # survivable because every action above reconnects on demand, but a reauth on
    # one TV does briefly disconnect the others.
    adb kill-server >/dev/null 2>&1
    adb start-server >/dev/null 2>&1
    adb connect "$TV" >/dev/null 2>&1
    sleep 1
    # Someone still has to tap Allow, so report what we ended up with rather
    # than claiming success.
    report connected ;;

  *)
    echo "usage: tv-remote {key <KEYCODE>|text <string> [enter]|clear [n]|app <package>|inputs|status|reauth}" >&2
    exit 2 ;;
esac
