    "views": [
      {
        "id": "keypress",
        "label": "A key press",
        "focus": [
          "pad",
          "panel",
          "service",
          "shim",
          "adb",
          "tv"
        ],
        "note": "The pad hands a key to the Panel, whose action becomes one shim call, one adb command, one TV keyevent."
      },
      {
        "id": "settings",
        "label": "Settings round trip",
        "focus": [
          "picker",
          "pad",
          "panel",
          "config",
          "shelljson",
          "bar"
        ],
        "note": "Forms in the picker write through Config, which merges and hands the whole entry back to the shell."
      },
      {
        "id": "probes",
        "label": "Reachability",
        "focus": [
          "service",
          "shim",
          "adb",
          "tv"
        ],
        "note": "Service polls the active set and probes all of them while the picker is open; the shim reconnects on demand."
      }
    ]
  },
