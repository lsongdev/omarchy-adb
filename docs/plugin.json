    "views": [
      {
        "id": "keypress",
        "label": "A key press",
        "focus": [
          "pad",
          "panel",
          "service",
          "shim",
          "adb",
          "tv"
        ],
        "note": "The pad hands a key to the Panel, whose action becomes one shim call, one adb command, one TV keyevent."
      },
      {
        "id": "settings",
        "label": "Settings round trip",
        "focus": [
          "tvform",
          "setpicker",
          "panel",
          "config",
          "shelljson"
        ],
        "note": "A form writes through Config, which merges and hands the whole entry back to the shell."
      },
      {
        "id": "picker",
        "label": "The picker",
        "focus": [
          "setpicker",
          "tvrow",
          "action",
          "tvform",
          "appchooser"
        ],
        "note": "One row per set, three action rows, and whichever of the two forms is open."
      },
      {
        "id": "primitives",
        "label": "The primitives",
        "focus": [
          "field",
          "typefield",
          "formbutton",
          "hintarea",
          "padtext"
        ],
        "note": "Every readable thing is a PadText and every hover a HintArea; they sit inside all of the components above."
      }
    ]
  },
