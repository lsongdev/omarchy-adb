{
  "schemaVersion": 1,
  "id": "io.github.swey-l1.atv-remote",
  "name": "Android TV Remote",
  "version": "1.3.0",
  "author": "swey-l1",
  "license": "MIT",
  "description": "Drive an Android TV from the Omarchy bar over ADB: D-pad, volume, inputs, typing and app shortcuts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Android TV Remote",
    "description": "D-pad, volume, input picker, on-screen typing, app shortcuts and full keyboard control for up to three Android TVs over ADB.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "tv1Label": "",
      "tv1Address": "",
      "tv2Label": "",
      "tv2Address": "",
      "tv3Label": "",
      "tv3Address": "",
      "activeSlot": 0,
      "pollSec": 60,
      "app1Label": "APP1",
      "app1Package": "",
      "app2Label": "APP2",
      "app2Package": "",
      "app3Label": "APP3",
      "app3Package": ""
    },
    "schema": [
      {
        "key": "tv1Label",
        "type": "string",
        "label": "TV 1 name",
        "defaultValue": ""
      },
      {
        "key": "tv1Address",
        "type": "string",
        "label": "TV 1 address (host:port)",
        "defaultValue": ""
      },
      {
        "key": "tv2Label",
        "type": "string",
        "label": "TV 2 name",
        "defaultValue": ""
      },
      {
        "key": "tv2Address",
        "type": "string",
        "label": "TV 2 address (host:port)",
        "defaultValue": ""
      },
      {
        "key": "tv3Label",
        "type": "string",
        "label": "TV 3 name",
        "defaultValue": ""
      },
      {
        "key": "tv3Address",
        "type": "string",
        "label": "TV 3 address (host:port)",
        "defaultValue": ""
      },
      {
        "key": "pollSec",
        "type": "integer",
        "label": "Reachability poll (seconds)",
        "min": 10,
        "max": 600,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "app1Label",
        "type": "string",
        "label": "Shortcut 1 label",
        "defaultValue": "APP1"
      },
      {
        "key": "app1Package",
        "type": "string",
        "label": "Shortcut 1 package",
        "defaultValue": ""
      },
      {
        "key": "app2Label",
        "type": "string",
        "label": "Shortcut 2 label",
        "defaultValue": "APP2"
      },
      {
        "key": "app2Package",
        "type": "string",
        "label": "Shortcut 2 package",
        "defaultValue": ""
      },
      {
        "key": "app3Label",
        "type": "string",
        "label": "Shortcut 3 label",
        "defaultValue": "APP3"
      },
      {
        "key": "app3Package",
        "type": "string",
        "label": "Shortcut 3 package",
        "defaultValue": ""
      }
    ]
  }
}
